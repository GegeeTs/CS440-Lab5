{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/check_project.py",
              "--hook"
            ],
            "timeout": 20
          }
        ]
      }
    ]
  }
}
